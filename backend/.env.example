# ─── Database ──────────────────────────────────────────────────────────────────
# Render: use the Internal Database URL from your Postgres service dashboard
DATABASE_URL="postgresql://user:password@host:5432/akwaluzto?schema=public"

# ─── Server ────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV="development"

# ─── URLs ──────────────────────────────────────────────────────────────────────
# FRONTEND_URL: your Vercel URL — used for CORS and all email confirmation links
# BACKEND_URL:  your Render URL — used for PayMob webhook registration
FRONTEND_URL="http://localhost:5173"
BACKEND_URL="http://localhost:4000"

# ─── Auth ──────────────────────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""

# ─── Email (Resend) ────────────────────────────────────────────────────────────
# Get API key: https://resend.com/api-keys
# Verify your domain: https://resend.com/domains
# Then set EMAIL_FROM to an address on your verified domain
RESEND_API_KEY=""
EMAIL_FROM="Akwaluzto <noreply@akwaluzto.com>"

# ─── AI Chatbot (Google Gemini) ────────────────────────────────────────────────
# Get free API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# ─── PayMob (Card Payments) ────────────────────────────────────────────────────
# Get from: https://accept.paymob.com → Settings → API Keys
PAYMOB_SECRET_KEY=""
PAYMOB_PUBLIC_KEY=""
PAYMOB_INTEGRATION_ID=""
PAYMOB_HMAC_SECRET=""
PAYMOB_BASE_URL="https://accept.paymob.com"
